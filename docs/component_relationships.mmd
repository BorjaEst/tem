%% Component Relationships and Dependencies
classDiagram
    class ModelConfig {
        +ArchitectureConfig architecture
        +EnvironmentConfig environment
        +InferenceConfig inference
        +TrainingConfig training
        +validate() ModelConfig
    }
    
    class TEMModel {
        +ModelConfig config
        +Encoder encoder
        +Processor processor
        +TransitionModel transition
        +GroundedLocInference grounded
        +AbstractLocInference abstract
        +MemoryStorage storage
        +AttractorDynamics attractor
        +Projection projection
        +Decoder decoder
        +forward(walk) steps
        +iteration(...) tuple
        +inference(...) tuple
        +generative(...) tuple
        +loss(...) list
    }
    
    class Encoder {
        +Tensor two_hot_table
        +forward(x) x_c
    }
    
    class Processor {
        +Parameter w_n
        +Parameter b_n
        +filter(x_c, x_prev) x_f
        +normalize(x_f) x_normalized
    }
    
    class TransitionModel {
        +MLP mlp_transition
        +MLP mlp_uncertainty
        +MLP mlp_no_direc
        +Parameter frequencies
        +forward(a, g, no_direc) g_gen
    }
    
    class GroundedLocInference {
        +Tensor W_repeat
        +Tensor W_tile
        +Parameter w_x
        +Parameter w_g
        +Parameter w_pc
        +forward(g, x_f) p_inf
    }
    
    class AbstractLocInference {
        +MLP mlp_mem
        +MLP mlp_shiny
        +forward(g_gen, σ_gen, p_x, shiny) g_inf
    }
    
    class MemoryStorage {
        +Tensor M_gen
        +Optional Tensor M_inf
        +Tensor p_update_mask
        +update(p_inf, p_gen, η, λ)
        +get_memory(for_inference) M
    }
    
    class AttractorDynamics {
        +List Tensor p_retrieve_masks
        +retrieve(p_query, M, for_inference) p
    }
    
    class Projection {
        +Parameter frequencies
        +Tensor g_downsample
        +downsample(g) g_downsampled
        +normalize_g(g) g_normalized
        +clamp_g(g) g_clamped
        +p_to_g(p) g
    }
    
    class Decoder {
        +MLP mlp_decompressor
        +forward(p) x_probs x_logits
    }
    
    ModelConfig --> TEMModel : initializes
    TEMModel --> Encoder : uses
    TEMModel --> Processor : uses
    TEMModel --> TransitionModel : uses
    TEMModel --> GroundedLocInference : uses
    TEMModel --> AbstractLocInference : uses
    TEMModel --> MemoryStorage : uses
    TEMModel --> AttractorDynamics : uses
    TEMModel --> Projection : uses
    TEMModel --> Decoder : uses
    
    Encoder ..> Processor : x_c
    Processor ..> GroundedLocInference : x_f
    TransitionModel ..> AbstractLocInference : g_gen σ_gen
    AttractorDynamics ..> AbstractLocInference : p_x
    AbstractLocInference ..> GroundedLocInference : g_inf
    GroundedLocInference ..> MemoryStorage : p_inf
    AttractorDynamics ..> Decoder : p
    MemoryStorage ..> AttractorDynamics : M
    Projection ..> AttractorDynamics : g_
